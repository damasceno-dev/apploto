{
  "name": "@loto/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./queries": "./src/queries/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json",
    "lint": "eslint . && node scripts/check-boundary.ts",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "export:openapi": "node scripts/export-openapi.ts",
    "export:check": "node scripts/export-openapi.ts --check",
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/check-generated.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "orval": "8.39.0",
    "react": "19.3.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
