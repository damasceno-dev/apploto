{
  // Root TypeScript baseline for the source-package workspace (Shared M1, Phase 2).
  // Every workspace package extends this file and adds its own `include`.
  // App tsconfigs (Next in `web/`, Expo in `mobile/`) also extend it and may override
  // the module settings their frameworks require; each override is recorded with its
  // reason in the app's tsconfig.
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "skipLibCheck": true,
    "noEmit": true
  }
}
