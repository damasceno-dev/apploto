        "fg": [
          "nav.text-muted"
        ],
        "bg": [
          "nav.bg"
        ]
      },
      {
        "id": "top bar text",
        "kind": "text",
        "fg": [
          "text.primary",
          "text.secondary",
          "text.muted",
          "text.link"
        ],
        "bg": [
          "topbar.bg"
        ]
      },
      {
        "id": "essential control boundary",
        "kind": "non-text",
        "fg": [
          "border.control",
          "border.control-hover",
          "border.control-invalid",
          "action.secondary.border",
          "action.danger.border"
