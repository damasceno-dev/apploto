  "$contrast": {
    "$description": "Declared foreground/background pairs checked by scripts/check-contrast.mjs in both themes. Paths are relative to color.semantic.<theme>. A background is a single opaque token or a bottom-to-top stack of tokens; a translucent token must sit on an opaque base. Coverage rules in the checker fail any text/fg, control-border or focus token that no pair checks.",
    "thresholds": {
      "text": 4.5,
      "large-text": 3,
      "non-text": 3,
      "disabled": 3
    },
    "domainSurfaces": [
      "background",
      "surface.default",
      "surface.subtle",
      "surface.raised",
      "surface.hover",
      [
        "surface.default",
        "surface.selected"
      ]
    ],
    "pairs": [
      {
        "id": "body text on every surface",
        "kind": "text",
        "fg": [
          "text.primary",
          "text.secondary",
          "text.muted",
          "text.placeholder",
          "text.link",
          "text.link-hover"
        ],
        "bg": [
          "background",
          "surface.default",
          "surface.subtle",
          "surface.raised",
          "surface.hover",
          [
            "surface.default",
            "surface.selected"
          ],
          "surface.muted"
        ]
      },
      {
        "id": "disabled label (WCAG-exempt; project floor)",
        "kind": "disabled",
        "fg": [
          "action.disabled.fg",
          "text.disabled"
        ],
        "bg": [
          "action.disabled.bg",
          "surface.default",
          "surface.muted"
        ]
      },
      {
        "id": "secondary accent (Meu turno) text",
        "kind": "text",
        "fg": [
          "accent.secondary-fg"
        ],
        "bg": [
          "surface.default",
          [
            "surface.default",
            "accent.secondary-bg"
          ],
          [
            "topbar.bg",
            "accent.secondary-bg"
          ]
        ]
      },
      {
        "id": "navigation text",
        "kind": "text",
