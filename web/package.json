{
  "name": "@loto/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=react-server tooling/run-next.mjs dev",
    "build": "node --conditions=react-server tooling/run-next.mjs build && node tooling/check-bundles.mjs",
    "start": "node --conditions=react-server tooling/run-next.mjs start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && node tooling/check-css.mjs",
    "test": "node --test tooling/*.test.mjs",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@loto/api": "workspace:*",
    "@loto/core": "workspace:*",
    "@next/env": "16.4.2",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "color-name": "2.1.0",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "postcss-value-parser": "4.2.0",
    "tailwindcss": "4.3.3"
  }
}
