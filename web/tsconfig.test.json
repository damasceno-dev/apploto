{
  // Unit/end-to-end tests and their configs (Web M2). Not part of the app build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "e2e/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".next/types/**/*.ts"
  ]
}
