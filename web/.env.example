# Server-only configuration. Copy to .env.local for local development.
# Never prefix these variables with NEXT_PUBLIC_: the browser reaches the API only through the BFF.

# Required for dev/build/start: the API the BFF and Server Components call.
LOTO_API_BASE_URL=http://localhost:5000

# Optional: the public origin of this web app when it runs behind a proxy that changes the Host
# or scheme. Unset, BFF state changes must come from the request's own origin.
# LOTO_WEB_ORIGIN=https://app.example

# Optional, tests only: build and serve the technical end-to-end fixtures (`page.e2e.tsx`).
# LOTO_WEB_E2E_FIXTURES=1
