# M1 reads no API URL and makes no API calls. Mobile M2 will inject this value.
# iOS simulator reaches the host at localhost; Android emulator uses 10.0.2.2.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
# Android emulator alternative: http://10.0.2.2:5000
# A physical device requires the development machine's reachable LAN address.
