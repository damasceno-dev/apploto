# Mobile M2: the app shell injects this public base URL into Shared's client.
# Release requires HTTPS. Set an actual development API URL in a local ignored .env.
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5100
# Choose a verified free API port; macOS AirPlay commonly occupies 5000.
# For Android localhost, forward that API port with adb reverse on the selected emulator.
# Android emulator alternative: http://10.0.2.2:5100

# Optional DEV-only technical harness; use fake accounts and an owned disposable local API.
# EXPO_PUBLIC_NATIVE_SESSION_PROOF=1
# Native automation may inject text without opening the device IME/tutorial panels.
# EXPO_PUBLIC_NATIVE_AUTOMATION_INPUT=1
# Optional input-data prefill from the owned native fixture server; contains fake accounts only.
# EXPO_PUBLIC_NATIVE_FIXTURE_PREFILL=1
# Optional localhost-only raw Hermes measurement collector (no authentication data).
# EXPO_PUBLIC_NATIVE_PROBE_SINK=http://127.0.0.1:51999/capture
