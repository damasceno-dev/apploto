{
  "name": "@loto/mobile",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node tooling/native.mjs start",
    "ios": "node tooling/native.mjs ios",
    "android": "node tooling/native.mjs android",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . && node tooling/check-css.mjs && node tooling/auth-policy.mjs --check",
    "test": "node --test tooling/*.test.mjs && jest --runInBand",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "native:doctor": "node tooling/native.mjs doctor",
    "native:proof:android": "node tooling/native.mjs proof-android",
    "generate:auth": "node tooling/auth-policy.mjs"
  },
  "dependencies": {
    "@loto/api": "workspace:*",
    "@loto/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "57.0.31",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.29",
    "expo-secure-store": "57.0.4",
    "expo-system-ui": "57.0.4",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "babel-preset-expo": "57.0.16",
    "color-name": "2.1.0",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "postcss": "8.5.31",
    "postcss-value-parser": "4.2.0",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.19"
  }
}
