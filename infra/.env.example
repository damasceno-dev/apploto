# Copy this file to `.env` on the target host.
# Keep the real `.env` out of git.
# Use one `.env` per hosted environment.

ASPNETCORE_ENVIRONMENT=Staging

SERVER_DB_HOST=127.0.0.1
SERVER_DB_PORT=5432
SERVER_DB_NAME=loto_staging
SERVER_DB_USERNAME=postgres
SERVER_DB_PASSWORD=replace-me

SERVER_TOKEN_SIGNING_KEY=replace-with-a-long-random-secret
SERVER_TOKEN_EXPIRATION_MINUTES=60
